		</member>
		<member name="power_current_collector_max_collector_lifting" type="float" setter="set_power_current_collector_max_collector_lifting" getter="get_power_current_collector_max_collector_lifting" default="0.0">
			Maximum collector lifting, in meters.
		</member>
