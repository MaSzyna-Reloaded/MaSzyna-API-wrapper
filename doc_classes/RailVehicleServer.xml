		<method name="load_add">
			<return type="void" />
			<param index="0" name="vehicle" type="RID" />
			<param index="1" name="amount" type="float" />
			<param index="2" name="side" type="int" enum="RailVehicleLoad.PlatformSide" />
			<param index="3" name="load_name" type="String" default="&quot;&quot;" />
			<description>
				So much more to get on [param vehicle] at the platform's [param side], in the vehicle's own frame ([method RailVehicleLoad.load_add]); an empty vehicle takes [param load_name], or the first load it accepts. The vehicle's [code]load_add[/code] command (amount, side) comes here.
			</description>
		</method>
		<method name="load_get_exchange_time" qualifiers="const">
			<return type="float" />
			<param index="0" name="vehicle" type="RID" />
			<description>
				The seconds the exchange of [param vehicle] still takes ([method RailVehicleLoad.get_load_exchange_time]); 0 for none, or for a vehicle that carries no load.
			</description>
		</method>
		<method name="load_remove">
			<return type="void" />
			<param index="0" name="vehicle" type="RID" />
			<param index="1" name="amount" type="float" />
			<param index="2" name="side" type="int" enum="RailVehicleLoad.PlatformSide" />
			<description>
				So much more to get off [param vehicle] at the platform's [param side], in the vehicle's own frame ([method RailVehicleLoad.load_remove]). The vehicle's [code]load_remove[/code] command (amount, side) comes here.
			</description>
		</method>
		<method name="trainset_add_vehicle">
			<return type="void" />
			<param index="0" name="trainset" type="RID" />
			<param index="1" name="vehicle" type="RID" />
			<param index="2" name="direction" type="int" enum="TrackServer.Direction" />
			<param index="3" name="gap" type="float" />
			<param index="4" name="coupling" type="int" enum="RailVehicleController.CouplingFlags" is_bitfield="true" />
			<description>
				The next vehicle of the trainset: which way it stands, how far behind the one before it [m] (none when it stands reversed) and how it couples to the next one.
			</description>
		</method>
		<method name="trainset_clear">
			<return type="void" />
			<param index="0" name="trainset" type="RID" />
			<description>
				The trainset has no vehicles.
			</description>
		</method>
		<method name="trainset_create">
			<return type="RID" />
			<description>
				A scenery's trainset: vehicles standing one after another on a track, coupled.
			</description>
		</method>
		<method name="trainset_free">
			<return type="void" />
			<param index="0" name="trainset" type="RID" />
			<description>
				Frees the trainset; its vehicles stay.
			</description>
		</method>
		<method name="trainset_get_name" qualifiers="const">
			<return type="String" />
			<param index="0" name="trainset" type="RID" />
			<description>
				The scenery's name of the trainset, empty for one that has none.
			</description>
		</method>
		<method name="trainset_get_vehicles" qualifiers="const">
			<return type="RID[]" />
			<param index="0" name="trainset" type="RID" />
			<description>
				The trainset's vehicles, in order.
			</description>
		</method>
		<method name="trainset_move">
			<return type="void" />
			<param index="0" name="vehicle" type="RID" />
			<param index="1" name="distance" type="float" />
			<description>
				Moves the whole trainset coupled to [param vehicle] by [param distance] meters towards the vehicle's front, every vehicle whichever way round it stands ([code]TDynamicObject::move_set()[/code], [code]DynObj.cpp:4302[/code]).
			</description>
		</method>
		<method name="trainset_place">
			<return type="void" />
			<param index="0" name="trainset" type="RID" />
			<description>
				Stands the vehicles on the track one after another, each as long as it is, and couples them - at once, or as soon as every vehicle of it has its simulation.
			</description>
		</method>
		<method name="trainset_set_name">
			<return type="void" />
			<param index="0" name="trainset" type="RID" />
			<param index="1" name="name" type="String" />
			<description>
				The scenery's name of the trainset, only to show it - a trainset is held by its handle.
			</description>
		</method>
		<method name="trainset_set_track">
			<return type="void" />
			<param index="0" name="trainset" type="RID" />
			<param index="1" name="track" type="RID" />
			<param index="2" name="offset" type="float" />
			<description>
				Where the trainset's front stands - the track and the distance along it [m].
			</description>
		</method>
