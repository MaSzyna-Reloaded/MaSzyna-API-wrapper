[node name="SentDialog" parent="." instance=ExtResource("11_ui_dialog")]
unique_name_in_owner = true
title = "Report sent"
message = "Thank you, the report has been sent."
confirm_text = "OK"
alternative_text = "Open the report"

[node name="UnavailableDialog" parent="." instance=ExtResource("11_ui_dialog")]
unique_name_in_owner = true
title = "Reporting unavailable"
message = "Reporting problems is not available in this version of the game."
confirm_text = "OK"

[connection signal="report_failed" from="Sender" to="ReportDialog" method="show_failed"]
[connection signal="report_saved" from="Sender" to="." method="close_report" unbinds=1]
[connection signal="report_sent" from="Sender" to="." method="_on_report_sent"]
[connection signal="confirmed" from="SentDialog" to="." method="close_report"]
[connection signal="dismissed" from="SentDialog" to="." method="close_report"]
[connection signal="alternative_chosen" from="SentDialog" to="." method="_on_sent_dialog_alternative_chosen"]
[connection signal="request_completed" from="Sender" to="Sender" method="_on_request_completed"]
[connection signal="pressed" from="EdgeButton" to="." method="open_report"]
[connection signal="close_requested" from="ReportDialog" to="." method="close_report"]
[connection signal="text_changed" from="ReportDialog/Frame/Layout/Body/Rows/Description" to="ReportDialog" method="_update_send_button"]
[connection signal="toggled" from="ReportDialog/Frame/Layout/Body/Rows/AttachScreenshotRow/AttachScreenshot" to="ReportDialog" method="_on_attach_screenshot_toggled"]
[connection signal="toggled" from="ReportDialog/Frame/Layout/Body/Rows/ConsentRow/Consent" to="ReportDialog" method="_update_send_button" unbinds=1]
[connection signal="pressed" from="ReportDialog/Frame/Layout/Body/Rows/Buttons/CloseButton" to="." method="close_report"]
[connection signal="pressed" from="ReportDialog/Frame/Layout/Body/Rows/Buttons/SendButton" to="." method="send_report"]

