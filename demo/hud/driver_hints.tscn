[gd_scene format=3]

[ext_resource type="Script" path="res://hud/driver_hints.gd" id="1_hints"]
[ext_resource type="Theme" path="res://hud/timetable_theme.tres" id="2_theme"]
[ext_resource type="Script" path="res://ui/ui_chip.gd" id="ui_chip"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_key_cap"]
content_margin_left = 6.0
content_margin_top = 0.0
content_margin_right = 6.0
content_margin_bottom = 1.0
bg_color = Color(0.96, 0.96, 0.94, 1)
border_width_bottom = 3
border_color = Color(0.62, 0.63, 0.65, 1)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4

[sub_resource type="Theme" id="Theme_key_caps"]
KeyCap/base_type = &"PanelContainer"
KeyCap/styles/panel = SubResource("StyleBoxFlat_key_cap")
KeyCapLabel/base_type = &"Label"
KeyCapLabel/colors/font_color = Color(0.1, 0.11, 0.13, 1)
KeyCapLabel/font_sizes/font_size = 12

[node name="DriverHints" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
visible = false
mouse_filter = 2
theme = ExtResource("2_theme")
script = ExtResource("1_hints")

[node name="HintsTile" type="PanelContainer" parent="."]
unique_name_in_owner = true
custom_minimum_size = Vector2(360, 0)
layout_mode = 1
anchors_preset = 1
anchor_left = 1.0
anchor_right = 1.0
offset_left = -16.0
offset_top = 104.0
offset_right = -16.0
offset_bottom = 104.0
grow_horizontal = 0
mouse_filter = 2
script = ExtResource("ui_chip")

[node name="Layout" type="VBoxContainer" parent="HintsTile"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 2

[node name="Caption" type="Label" parent="HintsTile/Layout"]
layout_mode = 2
theme_type_variation = &"DrivingAidCaption"
text = "Hints"

[node name="HintList" type="VBoxContainer" parent="HintsTile/Layout"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme = SubResource("Theme_key_caps")
theme_override_constants/separation = 2

[node name="EmptyText" type="Label" parent="HintsTile/Layout"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"DrivingAidHint"
text = "No hints"

[node name="RefreshTimer" type="Timer" parent="."]
unique_name_in_owner = true
wait_time = 0.5

[connection signal="visibility_changed" from="." to="." method="_on_visibility_changed"]
[connection signal="timeout" from="RefreshTimer" to="." method="_on_refresh_timer_timeout"]
