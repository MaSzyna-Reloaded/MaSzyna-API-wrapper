msgstr "Zgadzam się na przekazanie informacji o sprzęcie i zgłoszeniu, i na opublikowanie ich w serwisie GitHub"

msgid "Close"
msgstr "Zamknij"

msgid "Send report"
msgstr "Wyślij zgłoszenie"

msgid "Sending..."
msgstr "Wysyłanie..."

msgid "Sending failed: %s"
msgstr "Wysyłanie nie powiodło się: %s"

msgid "Reporting unavailable"
msgstr "Zgłaszanie niedostępne"

msgid "Reporting problems is not available in this version of the game."
msgstr "Zgłaszanie problemów nie jest dostępne w tej wersji gry."

msgid "The report could not be sent (error %d)"
msgstr "Nie udało się wysłać zgłoszenia (błąd %d)"

msgid "The report was refused (HTTP %d)"
msgstr "Zgłoszenie zostało odrzucone (HTTP %d)"

msgid "Report sent"
msgstr "Zgłoszenie wysłane"

msgid "Thank you, the report has been sent."
msgstr "Dziękujemy, zgłoszenie zostało wysłane."

msgid "Open the report"
msgstr "Otwórz zgłoszenie"

msgid "OK"
msgstr "OK"
