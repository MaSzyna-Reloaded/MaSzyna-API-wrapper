[gd_scene format=3]

[ext_resource type="Script" path="res://settings/setting_text.gd" id="1_text"]
[ext_resource type="Script" path="res://ui/ui_text_field.gd" id="ui_text_field"]

[node name="SettingText" type="PanelContainer"]
mouse_filter = 1
theme_type_variation = &"SettingItem"
script = ExtResource("1_text")

[node name="Line" type="HBoxContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 8

[node name="Title" type="Label" parent="Line"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 16
autowrap_mode = 3

[node name="Field" type="LineEdit" parent="Line"]
unique_name_in_owner = true
custom_minimum_size = Vector2(220, 0)
layout_mode = 2
size_flags_vertical = 4
focus_mode = 1
script = ExtResource("ui_text_field")
select_all_on_focus = true

[node name="UnitColumn" type="Control" parent="Line"]
custom_minimum_size = Vector2(24, 0)
layout_mode = 2
mouse_filter = 2

[node name="ResetColumn" type="Control" parent="Line"]
custom_minimum_size = Vector2(24, 0)
layout_mode = 2
mouse_filter = 2

[connection signal="text_submitted" from="Line/Field" to="." method="_on_field_text_submitted"]
[connection signal="focus_exited" from="Line/Field" to="." method="_on_field_focus_exited"]
