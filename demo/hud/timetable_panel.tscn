layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Stations" type="VBoxContainer" parent="Content/StationsScroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2
