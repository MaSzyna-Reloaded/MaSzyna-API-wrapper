			</description>
		</method>
		<method name="vehicle_find_powered" qualifiers="const">
			<return type="RID" />
			<param index="0" name="vehicle" type="RID" />
			<description>
				The vehicle a cab of [param vehicle] drives ([code]FindPowered()[/code]): itself when powered, else the nearest powered vehicle joined to it - within its unit for an EMU or DMU, else by the control line; [param vehicle] when there is none.
			</description>
