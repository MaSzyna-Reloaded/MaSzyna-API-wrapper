			<description>
				Operate compressor
			</description>
		</method>
		<method name="converter">
			<return type="void" />
			<param index="0" name="enabled" type="bool" />
			<description>
				Operate converter
			</description>
		</method>
	</methods>
	<members>
		<member name="power_accumulator_recharge_source" type="int" setter="set_power_accumulator_recharge_source" getter="get_power_accumulator_recharge_source" enum="TrainController.TrainPowerSource" default="0">
