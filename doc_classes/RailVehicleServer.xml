		<method name="trainset_move">
			<return type="void" />
			<param index="0" name="vehicle" type="RID" />
			<param index="1" name="distance" type="float" />
			<description>
				Moves the whole trainset coupled to [param vehicle] by [param distance] meters towards the vehicle's front, every vehicle whichever way round it stands ([code]TDynamicObject::move_set()[/code], [code]DynObj.cpp:4302[/code]).
			</description>
		</method>
		<method name="trainset_place">
			<return type="void" />
			<param index="0" name="trainset" type="RID" />
			<description>
				Stands the vehicles on the track one after another, each as long as it is, and couples them - at once, or as soon as every vehicle of it has its simulation.
			</description>
		</method>
