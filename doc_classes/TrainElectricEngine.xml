		</member>
		<member name="power_cable_source" type="int" setter="set_power_cable_source" getter="get_power_cable_source" enum="TrainController.TrainPowerType" default="0">
			Energy source for the power cable
		</member>
		<member name="power_cable_steam_pressure" type="float" setter="set_power_cable_steam_pressure" getter="get_power_cable_steam_pressure" default="0.0">
