; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="MaSzyna Reloaded"
config/description="A port of MaSzyna Train Simulator"
run/main_scene="uid://dacvr0rfpjx5a"
run/print_header=false
config/features=PackedStringArray("4.7", "Double Precision", "Forward Plus")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
boot_splash/image="res://splash.png"
config/icon="res://icon.svg"
run/disable_stdout.release=true
run/print_header.release=true
run/disable_stderr.release=true

[audio]

buses/default_bus_layout="uid://cnafyk2xbhsdb"

[autoload]

MaszynaModelManager="*res://addons/libmaszyna/e3d/e3d_model_manager.gd"
TrackRenderingServer="*res://addons/libmaszyna/servers/track_rendering_server.gd"
TractionRenderingServer="*res://addons/libmaszyna/servers/traction_rendering_server.gd"
TractionPowerServer="*res://addons/libmaszyna/servers/traction_power_server.gd"
TrackManager="*res://addons/libmaszyna/tracks/track_manager.gd"
RailVehiclePhysicsServer="*res://addons/libmaszyna/servers/rail_vehicle_physics_server.gd"
NodebankLibraryBuilder="*uid://dv25nc25tcanw"
Console="*uid://d046w0soh2iou"
MaterialManager="*uid://wsbd7kr83ncg"
MaterialParser="*uid://7b48fl428yqa"
MaterialFactory="*uid://v144f3irjg7m"
E3DModelManager="*uid://b2v733o52i40x"
DynamicRailVehicle3DManager="*res://addons/libmaszyna/dynamic_rail_vehicle_3d_manager.gd"
E3DNodesInstancer="*uid://dl44jll5gimwi"
E3DModelTool="*uid://df7a5f7f35wd1"
AudioStreamManager="*uid://cp8sgfk334adm"
TrainSoundSystem="*res://addons/libmaszyna/sound/train_sound_system.gd"
CabinSystem="*res://addons/libmaszyna/cabin/cabin_system.gd"
GndSfxSystem="*res://addons/gnd_sfx/gnd_sfx_system.gd"
FIZResourceLoaderRegistrar="*uid://c3g4562u11dp2"
DebugMenu="*uid://cggqb75a8w8r"
SceneryInstancer="*uid://d33kyubri6utw"

[debug]

file_logging/log_path="user://logs/app.log"

[display]

window/size/mode=3
window/size/initial_position_type=3

[editor_overrides]

text_editor/behavior/files/trim_trailing_whitespace_on_save=true

[editor_plugins]

enabled=PackedStringArray("res://addons/debug_menu/plugin.cfg", "res://addons/gnd_sfx/plugin.cfg", "res://addons/gnd_skydome/plugin.cfg", "res://addons/gnd_weather/plugin.cfg", "res://addons/gut/plugin.cfg", "res://addons/libmaszyna/editor/e3d_toolbar/plugin.cfg", "res://addons/libmaszyna/editor/fiz_toolbar/plugin.cfg", "res://addons/libmaszyna/editor/nodebank/plugin.cfg", "res://addons/libmaszyna/editor/scenery_toolbar/plugin.cfg", "res://addons/libmaszyna/editor/tracks/plugin.cfg", "res://addons/libmaszyna/editor/user_settings_dock/plugin.cfg", "res://addons/libmaszyna/plugin.cfg", "res://addons/sky_3d/plugin.cfg")

[gnd_skydome]

day_light_energy=2.0
shader_zenith_color=Color(0.11514282, 0.20309141, 0.3828125, 1)
shader_horizon_height=0.178
day_ambient_energy=0.325
day_ambient_sky_contribution=0.69
day_vol_fog_density=0.005
shader_night_sky_energy=0.165
night_vol_fog_density=0.121
clouds_color_shadow=Color(0.8515625, 0.8515625, 0.8515625, 1)
clouds_shadow_angular_distance_clear=1.0
clouds_evolution_strength=0.775
clouds_evolution_scale=0.198
clouds_scroll_b=Vector2(0.002, 0)
sun_halo_strength=0.14
sun_atmosphere_strength=0.07
moon_glow_strength=0.01
moon_glow_size=0.2
shader_atmosphere_sunset_boost=0.47

[gnd_weather]

precipitation_wind_strength=10.0
wind_influence=0.52
follow_height=0.855
rain_mesh_density=0.1
near_layer_speed_multiplier=0.93
near_rain_blur=0.7
near_rain_glow=1.0
mid_rain_blur=0.38
near_rain_color=Color(1, 1, 1, 0.1254902)
mid_rain_color=Color(0.49803922, 0.49803922, 0.49803922, 0.24313726)
visual_intensity=1.0
rain_roughness=0.2
rain_specular_fade_start=0.1
rain_specular_fade_end=3.0
rain_probe_max_count=128
rain_probe_distance=4.0

