back_text = "Later"
confirm_intent = 2

[node name="GameDirQuestion" parent="." instance=ExtResource("6_dialog")]
unique_name_in_owner = true
title = "Change the game directory"
message = "Changing the game directory ends the current game and goes back to the main menu."
confirm_text = "End the game and change the directory"
back_text = "Back"
confirm_intent = 3

[connection signal="pressed" from="Window/Layout/Header/CloseButton" to="." method="ask_save_or_discard"]
[connection signal="pressed" from="Window/Layout/Header/BackButton" to="." method="focus_section_list"]
[connection signal="activated" from="Window/Layout/Content/SectionList" to="." method="focus_page"]
[connection signal="cancelled" from="Window/Layout/Content/SectionList" to="." method="ask_save_or_discard"]
[connection signal="focus_requested" from="Window/Layout/Content/SectionList" to="." method="focus_section_list"]
[connection signal="item_selected" from="Window/Layout/Content/SectionList" to="." method="_on_section_list_item_selected"]
[connection signal="navigate_down" from="Window/Layout/Content/SectionList" to="." method="focus_actions"]
[connection signal="navigate_right" from="Window/Layout/Content/SectionList" to="." method="focus_page"]
[connection signal="cancelled" from="Window/Layout/ActionsSection" to="." method="ask_save_or_discard"]
[connection signal="navigate_up" from="Window/Layout/ActionsSection" to="." method="focus_content"]
[connection signal="pressed" from="Window/Layout/ActionsSection/ActionButtons/DiscardButton" to="." method="cancel"]
[connection signal="pressed" from="Window/Layout/ActionsSection/ActionButtons/SaveButton" to="." method="save"]
[connection signal="pressed" from="Window/Layout/ActionsSection/ActionButtons/DefaultsButton" to="." method="restore_defaults"]
[connection signal="confirmed" from="DiscardDialog" to="." method="discard"]
[connection signal="confirmed" from="CloseDialog" to="." method="save"]
[connection signal="alternative_chosen" from="CloseDialog" to="." method="discard"]
[connection signal="confirmed" from="RestartDialog" to="." method="restart"]
[connection signal="dismissed" from="RestartDialog" to="." method="_close"]
[connection signal="confirmed" from="GameDirQuestion" to="." method="change_game_dir"]
