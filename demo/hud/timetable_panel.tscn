[gd_scene format=3]

[ext_resource type="Script" path="res://hud/timetable_panel.gd" id="1_panel"]
[ext_resource type="Theme" path="res://hud/timetable_theme.tres" id="2_theme"]
[ext_resource type="Script" path="res://hud/window_move_handle.gd" id="3_move"]
[ext_resource type="Script" path="res://hud/window_resize_corner.gd" id="4_resize"]

[node name="TimetablePanel" type="PanelContainer"]
visible = false
custom_minimum_size = Vector2(340, 0)
anchors_preset = 1
anchor_left = 1.0
anchor_right = 1.0
offset_left = -436.0
offset_top = 44.0
offset_right = -16.0
grow_horizontal = 0
mouse_filter = 2
theme = ExtResource("2_theme")
theme_type_variation = &"TimetableCard"
script = ExtResource("1_panel")

[node name="Content" type="VBoxContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 8

[node name="MoveHandle" type="Control" parent="Content" node_paths=PackedStringArray("window")]
custom_minimum_size = Vector2(0, 10)
layout_mode = 2
mouse_default_cursor_shape = 13
script = ExtResource("3_move")
window = NodePath("../..")

[node name="Header" type="HBoxContainer" parent="Content"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 12

[node name="TrainInfo" type="VBoxContainer" parent="Content/Header"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2
theme_override_constants/separation = 0

[node name="Train" type="Label" parent="Content/Header/TrainInfo"]
unique_name_in_owner = true
layout_mode = 2
text = "No timetable"
theme_type_variation = &"TimetableTitle"
text_overrun_behavior = 3

[node name="TrainLabel" type="Label" parent="Content/Header/TrainInfo"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"TimetableMuted"
text_overrun_behavior = 3

[node name="Relation" type="Label" parent="Content/Header/TrainInfo"]
unique_name_in_owner = true
visible = false
layout_mode = 2
text_overrun_behavior = 3

[node name="ClockInfo" type="VBoxContainer" parent="Content/Header"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 4

[node name="Clock" type="Label" parent="Content/Header/ClockInfo"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"TimetableClock"
horizontal_alignment = 2

[node name="Delay" type="PanelContainer" parent="Content/Header/ClockInfo"]
unique_name_in_owner = true
visible = false
layout_mode = 2
size_flags_horizontal = 8
mouse_filter = 2
theme_type_variation = &"TimetablePill"

[node name="DelayText" type="Label" parent="Content/Header/ClockInfo/Delay"]
unique_name_in_owner = true
layout_mode = 2
