[node name="BugReport" type="CanvasLayer"]
layer = 100
script = ExtResource("1_report")

[node name="Sender" type="HTTPRequest" parent="."]
unique_name_in_owner = true
script = ExtResource("3_sender")

[node name="EdgeButton" type="Button" parent="."]
unique_name_in_owner = true
visible = false
anchors_preset = -1
anchor_left = 1.0
anchor_top = 0.5
anchor_right = 1.0
anchor_bottom = 0.5
offset_top = -28.0
offset_right = 56.0
offset_bottom = 28.0
grow_horizontal = 0
grow_vertical = 2
focus_mode = 0
tooltip_text = "Report a problem or suggestion"
theme_override_styles/normal = SubResource("StyleBoxFlat_edge")
theme_override_styles/hover = SubResource("StyleBoxFlat_edge_hover")
theme_override_styles/pressed = SubResource("StyleBoxFlat_edge")
icon = ExtResource("5_icon")
icon_alignment = 1
expand_icon = true
script = ExtResource("4_edge")

[node name="ReportDialog" parent="." instance=ExtResource("12_ui_window")]
unique_name_in_owner = true
title = "Report a problem or suggestion"
script = ExtResource("6_dialog")

[node name="Backdrop" parent="ReportDialog" index="0"]
color = Color(0, 0, 0, 0)

[node name="Rows" type="VBoxContainer" parent="ReportDialog/Frame/Layout/Body"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 10

[node name="DescriptionLabel" type="Label" parent="ReportDialog/Frame/Layout/Body/Rows"]
layout_mode = 2
text = "Describe the problem or the suggestion"

[node name="Description" type="TextEdit" parent="ReportDialog/Frame/Layout/Body/Rows"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 120)
layout_mode = 2
placeholder_text = "What happened, what did you expect, and how can it be repeated?"
wrap_mode = 1

[node name="AttachScreenshotRow" type="HBoxContainer" parent="ReportDialog/Frame/Layout/Body/Rows"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="AttachScreenshot" type="CheckButton" parent="ReportDialog/Frame/Layout/Body/Rows/AttachScreenshotRow"]
script = ExtResource("ui_switch")
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
button_pressed = true

[node name="AttachScreenshotLabel" type="Label" parent="ReportDialog/Frame/Layout/Body/Rows/AttachScreenshotRow"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 16
text = "Attach a screenshot"


[node name="AnnotationHint" type="Label" parent="ReportDialog/Frame/Layout/Body/Rows"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.7, 0.75, 0.82, 1)
text = "Drag to mark what the report is about in red; right-click removes the last mark."

[node name="ScreenshotAnnotator" type="Control" parent="ReportDialog/Frame/Layout/Body/Rows"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 200)
layout_mode = 2
size_flags_vertical = 3
mouse_default_cursor_shape = 3
script = ExtResource("7_annotator")

[node name="ConsentRow" type="HBoxContainer" parent="ReportDialog/Frame/Layout/Body/Rows"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Consent" type="CheckButton" parent="ReportDialog/Frame/Layout/Body/Rows/ConsentRow"]
script = ExtResource("ui_switch")
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4

[node name="ConsentLabel" type="Label" parent="ReportDialog/Frame/Layout/Body/Rows/ConsentRow"]
layout_mode = 2
size_flags_horizontal = 3
