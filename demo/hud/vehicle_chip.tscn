[gd_scene format=3]

[ext_resource type="Script" path="res://hud/vehicle_chip.gd" id="1_chip"]
[ext_resource type="Theme" path="res://hud/timetable_theme.tres" id="2_theme"]

[node name="VehicleChip" type="PanelContainer"]
visible = false
custom_minimum_size = Vector2(200, 0)
mouse_default_cursor_shape = 2
theme = ExtResource("2_theme")
script = ExtResource("1_chip")

[node name="Layout" type="HBoxContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 10

[node name="Icon" type="TextureRect" parent="Layout"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 2
stretch_mode = 3

[node name="DriverButton" type="Button" parent="Layout"]
unique_name_in_owner = true
visible = false
layout_mode = 2
size_flags_vertical = 4
focus_mode = 0
mouse_default_cursor_shape = 2

[node name="Info" type="VBoxContainer" parent="Layout"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2
theme_override_constants/separation = 0

[node name="Name" type="Label" parent="Layout/Info"]
unique_name_in_owner = true
layout_mode = 2

[node name="Status" type="Label" parent="Layout/Info"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"TimetableMuted"

[node name="ActionButton" type="Button" parent="Layout"]
unique_name_in_owner = true
visible = false
layout_mode = 2
size_flags_vertical = 4
focus_mode = 0
mouse_default_cursor_shape = 2
flat = true

[node name="RefreshTimer" type="Timer" parent="."]
unique_name_in_owner = true
wait_time = 0.5

[connection signal="visibility_changed" from="." to="." method="_on_visibility_changed"]
[connection signal="gui_input" from="." to="." method="_on_gui_input"]
[connection signal="mouse_entered" from="." to="." method="_on_mouse_entered"]
[connection signal="mouse_exited" from="." to="." method="_on_mouse_exited"]
[connection signal="timeout" from="RefreshTimer" to="." method="_on_refresh_timer_timeout"]
[connection signal="pressed" from="Layout/DriverButton" to="." method="_on_driver_button_pressed"]
[connection signal="pressed" from="Layout/ActionButton" to="." method="_on_action_button_pressed"]
